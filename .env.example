# Copie para .env (privado). Nunca use a conta de importação na API.
DATABASE_URL=postgresql://iago_runtime:SENHA_RUNTIME@127.0.0.1:54322/postgres
IMPORT_DATABASE_URL=postgresql://iago_importador:SENHA_IMPORTACAO@127.0.0.1:54322/postgres
# Somente provisionamento local; nunca é lida pela API.
ADMIN_DATABASE_URL=postgresql://postgres:SENHA_ADMIN_LOCAL@127.0.0.1:54322/postgres
EVENTO_CODIGO=acsn-inicial
DB_CONNECT_TIMEOUT=3

# Expiracao das sessoes, em horas.
SESSION_HOURS=8

# Session pooler ou conexão direta, ambos na porta 5432; valores ficam no .env.
SUPABASE_MIGRATION_URL=
IAGO_BANCO=local
SUPABASE_DATABASE_URL=
SUPABASE_IMPORT_DATABASE_URL=
