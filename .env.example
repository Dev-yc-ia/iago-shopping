APP_NAME="IAGO Shopping"
APP_VERSION="0.0.0-fase2"
ENVIRONMENT="production"

# Exemplo sem segredo. Não versionar .env real.
CORS_ORIGINS=["https://ia-go.api.br","https://www.ia-go.api.br"]

# Configuração pública do Supabase Auth. A anon key não é service role.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-anon-key-publica"

# Segredos usados somente por backend/Edge Functions em produção.
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase Edge Functions também aceitam as chaves novas do runtime:
# SUPABASE_SECRET_KEY="" ou SUPABASE_SECRET_KEYS='{"default":"sb_secret_..."}'

PAYMENT_PROVIDER="mercado_pago_prod"

MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_NOTIFICATION_URL="https://ualnmcvgddofqvijzfjt.supabase.co/functions/v1/mercado-pago-webhook"
MERCADO_PAGO_PAYMENT_EXPIRATION_MINUTES=30
MERCADO_PAGO_POLL_INTERVAL_MS=3000
